{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "github>mendersoftware/mendertesting//renovate/common.json5",
    "github>mendersoftware/mendertesting//renovate/go.json5",
    "github>mendersoftware/mendertesting//renovate/go-yocto-lts.json5"
  ],

  "baseBranchPatterns": ["master"],

  "packageRules": [
    // Docker base images: one grouped PR.
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker-base-images",
      "groupSlug": "docker-base-images"
    }
  ]
}
